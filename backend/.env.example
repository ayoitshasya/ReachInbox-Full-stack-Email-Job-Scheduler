# server
PORT=3001
NODE_ENV=development

# database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reachinbox

# redis
REDIS_URL=redis://localhost:6379

# google oauth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# jwt
JWT_SECRET=your_jwt_secret_here_change_in_production

# frontend url (for oauth redirect after login)
FRONTEND_URL=http://localhost:5173

# worker concurrency
WORKER_CONCURRENCY=5

# minimum delay between individual email sends (ms)
# this controls the bullmq rate limiter: max 1 job per MIN_SEND_DELAY_MS milliseconds
MIN_SEND_DELAY_MS=500

# hourly rate limits
MAX_EMAILS_PER_HOUR=1000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
